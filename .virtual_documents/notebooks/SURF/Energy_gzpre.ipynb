def event_energy(velocity_arr, mass, dt=15):
    kinetic_energy = 0.5 * mass * velocity_arr**2  # Joules at each step
    total_energy = np.sum(kinetic_energy) * dt       # Approximate integration
    return total_energy  # in joules


