class Event:
    def __init__(self, high, date, tide_h):
        self.high = high
        self.date = date
        self.tide_h = tide_h
    


class Cycle:
    def __init__(self, date, h_event= None, l_event = None, h_info = None, l_infor = None):
        self.date = date
        self.h_event = h_event # boolean whether there is high tide event
        self.l_event = l_event # boolean for low tide

        # Only store if events exist
        self.h_info = h_info if h_event is not None else None
        
        self.l_info = l_info if l_event is not None else None


# Want to make a list of cycle instances where it is the 
Events = []

for i, event in enumerate(tot_dat):
    date_time_now = event.at[0, 'start_time']
    date_time_next = tot_dat[i+1].at[0, 'start_time']
    
    index1 = tide_df[tide_df['time'] == date_time_now].index
    index2 = tide_df[tide_df['time'] == date_time_next].index
    
    # Indicator for high tide event vs low tide event
    tideCur = 0
    tideNext = 0
    tide1 = tide_df.at[index1[0], 'tide_height']
    tide2 = tide_df.at[index2[0], 'tide_height']
    
    if tide1 > 0:
        tideCur = 1

    if tide2 > 0:
        tideNext = 1

    if tideCur == 0 and tideNext == 0:
        continue
    # If it is both high tide events, append the current iteration's event to the list of instances
    # If it is a high tide event and then a low-tide event append to the list 

    if tidCur == 1 and tideNext == 1:
        Events.append(Cycle(date_time_now, h_event = True, l_event = False)
        
    if tideCur == 1 and tideNext == 0:
        Events.append(Cycle(date_time_now, h_event = True, l_event = True)

    
    
        
    

    






