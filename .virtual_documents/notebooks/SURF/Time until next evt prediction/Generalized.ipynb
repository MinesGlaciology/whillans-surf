# Goal: Explore more generalized models for predicting the time until next event

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split, GridSearchCV, StratifiedKFold
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.svm import SVC
from sklearn.metrics import (
    accuracy_score, precision_recall_fscore_support,
    classification_report, confusion_matrix
)
# Ideas
# Predicting the time bracket until the event. 
# Histogram of inter event time shows two large "humps" 
# Good splitting spot is 1100 minutes

df = pd.read_csv("/Users/sambrown04/Documents/SURF/Preproc_data/upd10-18.csv")


df.head()


plt.hist(df['time_since'], bins = 600)
plt.xlim([0,2000])


# Encode just two for now, below 1100 minutes and above 1100 minutes, name 


df['time_bracket'] = (df['time_since'] > 1100).astype(int)



df.head()


X = df[['tide_deriv', 'form_fac', 'slip_size_standardized', 'sev_stds', 'pre-s_stds', 'tide_height', 'inter_form_Fac', 'A_diurn', 'A_semidiurn', 'r2_standardized', 'slope_standardized']].to_numpy()
y = df['time_bracket'].to_numpy()

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.2, stratify=y, random_state=42
)






svm_pipe = Pipeline([
    ("scale", StandardScaler()),
    ("svm", SVC(probability=True))  # I'll turn on probability for later ROC/plots
])

# I want to try a few kernels and tune C & gamma
svm_params = {
    "svm__kernel": ["rbf", "linear"],
    "svm__C": [0.1, 1, 10],
    "svm__gamma": ["scale", 0.1, 0.01]  # only matters for non-linear kernels
}

# StratifiedKFold so each fold keeps class proportions
cv_setup = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)

# Grid search over my parameter space
svm_grid = GridSearchCV(
    estimator=svm_pipe,
    param_grid=svm_params,
    cv=cv_setup,
    scoring="accuracy",
    n_jobs=-1
)

# Fit to my training data
svm_grid.fit(X_train, y_train)

# Check what worked best
print("Best parameters found:", svm_grid.best_params_)

# Predict on the hold-out test set
test_preds = svm_grid.predict(X_test)

# Evaluate
print("Test Accuracy:", accuracy_score(y_test, test_preds))
print("Detailed report:\n", classification_report(y_test, test_preds))



