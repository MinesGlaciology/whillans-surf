tide_mod = "CATS2008-v2023"

tides = Tides.Tide(tide_mod, tide_dir)

model1 = pyTMD.io.model(tide_dir, format="netcdf").elevation(tide_mod)
constituents = pyTMD.io.OTIS.read_constants(
